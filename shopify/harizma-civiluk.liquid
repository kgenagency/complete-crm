{%- comment -%} HARIZMA civiluk: komadi vise na šipci, klik skida komad i otvara ga ispred kupca. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign n = 0
  assign json = ''
-%}
<style>
.hzr{--g:#1B2620;--b:#E8E4D9;--m:#7E8C74;--h:clamp(280px,min(31vw,56vh),430px);--w:calc(var(--h)*.56);--railY:calc(var(--h)*.028);
  position:relative;background:var(--b);color:var(--g);padding:clamp(40px,6vw,84px) 0 clamp(44px,6vw,80px);overflow:hidden;text-align:center}
.hzr *{box-sizing:border-box}
.hzr-head{display:flex;align-items:center;justify-content:center;gap:16px;margin:0 20px 10px;font:500 .75rem/1.4 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.24em;text-transform:uppercase}
.hzr-head i{width:1px;height:14px;background:currentColor;opacity:.35}
.hzr-head .m{color:var(--m)}
.hzr-title{margin:6px 20px 0;font:300 clamp(2rem,4.2vw,3.4rem)/1.04 var(--font-heading--family,'Cormorant Garamond',Georgia,serif);letter-spacing:.01em;color:var(--g)}
.hzr-stage{position:relative;margin-top:clamp(26px,4vw,44px)}
.hzr-track{position:relative}
.hzr-rail{position:absolute;left:clamp(8px,2vw,24px);right:clamp(8px,2vw,24px);top:var(--railY);height:10px;margin-top:-5px;z-index:3;pointer-events:none;display:flex;align-items:center}
.hzr-rail .bar{flex:1;height:7px;border-radius:4px;background:linear-gradient(180deg,#f4f4f2 0%,#bdbdb8 38%,#8d8d88 62%,#cfcfca 100%);box-shadow:0 3px 6px rgba(27,38,32,.18)}
.hzr-rail .cap{width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#fafaf8,#9a9a95 70%);box-shadow:0 2px 4px rgba(27,38,32,.25);flex:none}
.hzr-scroller{position:relative;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch;cursor:grab;padding-bottom:28px;
  -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 6%,#000 94%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0,#000 6%,#000 94%,transparent 100%)}
.hzr-scroller::-webkit-scrollbar{display:none}
.hzr-scroller.is-drag{cursor:grabbing;scroll-behavior:auto}
.hzr-track{list-style:none;margin:0;padding:0 clamp(28px,6vw,96px);display:flex;align-items:flex-start;width:max-content;min-width:100%;justify-content:center}
.hzr-item{position:relative;flex:none;width:var(--w);height:calc(var(--h)*1.02);margin:0 calc(var(--w)*-.06);
  transition:transform 1.15s cubic-bezier(.16,1,.3,1) calc(var(--i)*65ms),opacity .6s ease calc(var(--i)*65ms)}
.hzr:not(.is-in) .hzr-item{transform:translateX(70vw);opacity:0}
.hzr-hang{all:unset;position:absolute;inset:0;cursor:pointer;display:block;-webkit-tap-highlight-color:transparent}
.hzr-hang:focus-visible{outline:none}
.hzr-hang:focus-visible .hzr-lift::after{content:'';position:absolute;left:12%;right:12%;bottom:-14px;height:2px;background:var(--g)}
.hzr-swing,.hzr-lift{position:absolute;left:50%;top:0;width:calc(var(--h)*.667);height:var(--h);margin-left:calc(var(--h)*-.3335);
  transform-origin:50% calc(var(--hk,.03)*100%)}
.hzr-swing{top:calc(var(--hk,.03)*var(--h)*-1)}
.hzr-lift{left:0;margin-left:0;transition:transform .5s cubic-bezier(.2,.8,.2,1),filter .4s ease}
.hzr-lift img{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none;user-select:none;-webkit-user-drag:none;
  filter:drop-shadow(0 16px 14px rgba(27,38,32,.16)) drop-shadow(0 2px 2px rgba(27,38,32,.12))}
.hzr.is-in .hzr-swing{animation:hzr-settle 1.9s cubic-bezier(.3,.6,.4,1) calc(var(--i)*65ms + .55s) both,hzr-sway 7.5s ease-in-out calc(var(--i)*65ms + 2.5s) infinite}
@keyframes hzr-settle{0%{transform:rotate(-7deg)}22%{transform:rotate(4.2deg)}44%{transform:rotate(-2.3deg)}66%{transform:rotate(1.1deg)}84%{transform:rotate(-.4deg)}100%{transform:rotate(0)}}
@keyframes hzr-sway{0%,100%{transform:rotate(0)}30%{transform:rotate(.8deg)}70%{transform:rotate(-.7deg)}}
@keyframes hzr-nudge{0%{transform:rotate(0) scale(1.035)}25%{transform:rotate(2.6deg) scale(1.035)}55%{transform:rotate(-1.4deg) scale(1.035)}80%{transform:rotate(.5deg) scale(1.035)}100%{transform:rotate(0) scale(1.035)}}
.hzr-item:hover{z-index:5}
@media (hover:hover){
  .hzr-item:hover .hzr-lift{animation:hzr-nudge 1.4s cubic-bezier(.3,.7,.4,1) both}
  .hzr-track:hover .hzr-item:not(:hover) .hzr-lift{filter:saturate(.75) brightness(.98);opacity:.82}
  .hzr-lift{transition:transform .5s cubic-bezier(.2,.8,.2,1),filter .4s ease,opacity .4s ease}
}
.hzr-item.is-center .hzr-lift{transform:scale(1.03)}
.hzr-item.is-out .hzr-lift{opacity:0;transition:opacity .15s}
.hzr-tag{position:absolute;left:58%;top:calc(var(--h)*.07);z-index:2;font:600 .625rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.14em;text-transform:uppercase;
  background:var(--g);color:var(--b);padding:6px 8px 6px 9px;white-space:nowrap;transform:rotate(4deg);box-shadow:0 3px 8px rgba(27,38,32,.2)}
.hzr-tag::before{content:'';position:absolute;left:-7px;top:50%;width:5px;height:5px;margin-top:-2.5px;border-radius:50%;background:var(--b);box-shadow:0 0 0 1.5px var(--g)}
.hzr-name{min-height:3.2em;margin:4px 20px 0;display:flex;flex-direction:column;align-items:center;gap:4px;opacity:0;transform:translateY(6px);transition:opacity .35s ease,transform .35s ease}
.hzr-name.on{opacity:1;transform:none}
.hzr-name.hint .n{display:none}
.hzr-name.hint .p{font-size:.6875rem;letter-spacing:.2em;text-transform:uppercase}
.hzr-name .n{font:400 1.35rem/1.15 var(--font-heading--family,'Cormorant Garamond',Georgia,serif)}
.hzr-name .p{font:500 .8125rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.06em;color:var(--m)}
.hzr-cta{display:inline-block;margin-top:14px;font:500 .75rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.16em;text-transform:uppercase;color:var(--g);text-decoration:none;
  border:1px solid var(--g);padding:16px 28px;transition:background .25s ease,color .25s ease}
.hzr-cta:hover,.hzr-cta:focus-visible{background:var(--g);color:var(--b);outline:none}
.hzr-arrow{position:absolute;top:calc(var(--h)*.42);z-index:6;width:46px;height:46px;border-radius:50%;border:1px solid rgba(27,38,32,.25);background:rgba(232,228,217,.92);color:var(--g);
  display:none;align-items:center;justify-content:center;cursor:pointer;font-size:20px;line-height:1;transition:background .2s,opacity .2s}
.hzr-arrow:hover{background:var(--g);color:var(--b)}
.hzr-arrow[disabled]{opacity:0;pointer-events:none}
.hzr-arrow.l{left:clamp(10px,2vw,28px)}.hzr-arrow.r{right:clamp(10px,2vw,28px)}
.hzr.has-ovf .hzr-arrow{display:flex}
.hzr-hint{margin:0;font:500 .6875rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.18em;text-transform:uppercase;color:var(--m);opacity:.9}
/* komad ispred kupca */
.hzr-ov{--g:#1B2620;--b:#E8E4D9;--m:#7E8C74;position:fixed;inset:0;font-family:var(--font-body--family,'Montserrat',sans-serif);z-index:1000;display:grid;place-items:center;padding:24px;text-align:left}
.hzr-ov[hidden]{display:none}
.hzr-ov .bk{position:absolute;inset:0;background:rgba(232,228,217,.86);-webkit-backdrop-filter:blur(10px) saturate(.9);backdrop-filter:blur(10px) saturate(.9);opacity:0;transition:opacity .45s ease}
.hzr-ov.on .bk{opacity:1}
.hzr-m{position:relative;display:grid;grid-template-columns:auto minmax(280px,380px);gap:clamp(24px,4vw,64px);align-items:center;max-width:1100px;width:100%;justify-content:center}
.hzr-m-fig{position:relative;margin:0;height:min(76vh,720px);aspect-ratio:var(--ar,.667)}
.hzr-m-fig img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .35s ease}
.hzr-m-fig img.cut{filter:drop-shadow(0 26px 26px rgba(27,38,32,.2))}
.hzr-m-fig.show img.cut{opacity:1}
.hzr-m-fig.model img.cut{opacity:0}
.hzr-m-fig.model img.mod{opacity:1}
.hzr-m-fig img.mod{object-fit:cover;box-shadow:0 20px 50px rgba(27,38,32,.22)}
.hzr-m-info{opacity:0;transform:translateX(18px);transition:opacity .45s ease .1s,transform .55s cubic-bezier(.16,1,.3,1) .1s;color:var(--g)}
.hzr-ov.ready .hzr-m-info{opacity:1;transform:none}
.hzr-m-eb{font:500 .6875rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.22em;text-transform:uppercase;color:var(--m);margin:0 0 12px}
.hzr-m-t{font:300 clamp(2rem,3.2vw,2.8rem)/1.02 var(--font-heading--family,'Cormorant Garamond',Georgia,serif);margin:0 0 12px}
.hzr-m-p{font:500 1rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.04em;margin:0 0 22px;display:flex;gap:10px;align-items:baseline}
.hzr-m-p s{opacity:.5;font-weight:400;font-size:.875rem}
.hzr-m-l{font:500 .6875rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.18em;text-transform:uppercase;margin:0 0 10px;color:var(--g)}
.hzr-sz{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 22px}
.hzr-sz button{min-width:48px;height:44px;padding:0 14px;border:1px solid rgba(27,38,32,.35);background:transparent;color:var(--g);cursor:pointer;
  font:500 .8125rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.06em;border-radius:0;transition:background .2s,color .2s,border-color .2s}
.hzr-sz button:hover{border-color:var(--g)}
.hzr-sz button[aria-pressed=true]{background:var(--g);color:var(--b);border-color:var(--g)}
.hzr-sz button:disabled{opacity:.35;text-decoration:line-through;cursor:not-allowed}
.hzr-add{width:100%;height:54px;border:1px solid var(--g);background:var(--g);color:var(--b);cursor:pointer;border-radius:0;
  font:500 .8125rem/1 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.16em;text-transform:uppercase;transition:background .25s,color .25s}
.hzr-add:hover{background:transparent;color:var(--g)}
.hzr-add:disabled{opacity:.5;cursor:wait}
.hzr-add.done{background:var(--m);border-color:var(--m);color:#fff}
.hzr-links{display:flex;gap:18px;flex-wrap:wrap;align-items:center;margin-top:16px}
.hzr-links a,.hzr-links button{all:unset;cursor:pointer;font:500 .75rem/1.4 var(--font-body--family,'Montserrat',sans-serif);letter-spacing:.12em;text-transform:uppercase;color:var(--g);border-bottom:1px solid rgba(27,38,32,.4);padding-bottom:2px}
.hzr-links a:hover,.hzr-links button:hover,.hzr-links a:focus-visible,.hzr-links button:focus-visible{border-color:var(--g)}
.hzr-msg{min-height:1.4em;margin:12px 0 0;font:500 .75rem/1.4 var(--font-body--family,'Montserrat',sans-serif);color:var(--m)}
.hzr-x{position:absolute;top:18px;right:18px;z-index:2;width:46px;height:46px;border-radius:50%;border:1px solid rgba(27,38,32,.3);background:var(--b);color:var(--g);cursor:pointer;font-size:22px;line-height:1;
  opacity:0;transition:opacity .3s ease .2s,background .2s}
.hzr-ov.on .hzr-x{opacity:1}
.hzr-x:hover,.hzr-x:focus-visible{background:var(--g);color:var(--b);outline:none}
.hzr-fly{position:fixed;z-index:1001;pointer-events:none;object-fit:contain;transform-origin:0 0;will-change:transform;filter:drop-shadow(0 22px 22px rgba(27,38,32,.2))}
@media (max-width:749px){
  .hzr{--h:clamp(250px,72vw,330px)}
  .hzr-item{margin:0 calc(var(--w)*-.02)}
  .hzr-scroller{scroll-snap-type:x mandatory;cursor:auto;-webkit-mask-image:none;mask-image:none}
  .hzr-item{scroll-snap-align:center}
  .hzr-track{padding:0 calc(50vw - var(--w)*.5)}
  .hzr-arrow{display:none!important}
  .hzr-ov{padding:0;place-items:end center}
  .hzr-m{grid-template-columns:1fr;gap:0;height:100%;align-content:stretch;background:transparent}
  .hzr-m-fig{height:52vh;margin:max(58px,env(safe-area-inset-top)) auto 0}
  .hzr-m-info{background:var(--b);padding:20px 20px max(22px,env(safe-area-inset-bottom));box-shadow:0 -10px 30px rgba(27,38,32,.08);transform:translateY(24px);align-self:end}
  .hzr-m-t{font-size:2rem;margin-bottom:8px}
  .hzr-m-p{margin-bottom:16px}
  .hzr-sz{margin-bottom:16px}
  .hzr-x{top:max(12px,env(safe-area-inset-top));right:12px}
}
@media (prefers-reduced-motion:reduce){
  .hzr-item,.hzr:not(.is-in) .hzr-item{transition:none;transform:none;opacity:1}
  .hzr.is-in .hzr-swing,.hzr-item:hover .hzr-lift{animation:none!important}
}
</style>

<section id='hzr-{{ section.id }}' class='hzr' aria-label='{{ s.heading | default: s.eyebrow | escape }}'>
  {%- if s.eyebrow != blank or s.eyebrow2 != blank -%}
    <div class='hzr-head'>
      {%- if s.eyebrow != blank -%}<span>{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.eyebrow != blank and s.eyebrow2 != blank -%}<i aria-hidden='true'></i>{%- endif -%}
      {%- if s.eyebrow2 != blank -%}<span class='m'>{{ s.eyebrow2 }}</span>{%- endif -%}
    </div>
  {%- endif -%}
  {%- if s.heading != blank -%}<h2 class='hzr-title'>{{ s.heading }}</h2>{%- endif -%}
  <div class='hzr-stage'>
    <button type='button' class='hzr-arrow l' aria-label='Nazad'>&#8592;</button>
    <button type='button' class='hzr-arrow r' aria-label='Napred'>&#8594;</button>
    <div class='hzr-scroller'>
      <div class='hzr-track' role='list'>
        <div class='hzr-rail' aria-hidden='true'><span class='cap'></span><span class='bar'></span><span class='cap'></span></div>
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p == blank -%}{%- continue -%}{%- endif -%}
          {%- if s.hide_sold and p.available == false -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign img = block.settings.image
            if img == blank
              assign img = p.featured_image
            endif
            assign qty = 0
            for v in p.variants
              if v.inventory_quantity > 0
                assign qty = qty | plus: v.inventory_quantity
              endif
            endfor
            assign tag = block.settings.tag
            if tag == blank and p.compare_at_price > p.price
              assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price
              assign tag = '-' | append: pct | append: '%'
            endif
            if tag == blank and s.stock_tags and qty == 1
              assign tag = s.tag_last
            endif
          -%}
          <div class='hzr-item' role='listitem' style='--i:{{ n }}' {{ block.shopify_attributes }}>
            <button type='button' class='hzr-hang' aria-haspopup='dialog' aria-label='{{ p.title | escape }}, {{ p.price | money_without_trailing_zeros | strip_html | escape }}'>
              <span class='hzr-swing'><span class='hzr-lift'>
                {%- if img != blank -%}
                  <img src='{{ img | image_url: width: 700 }}' srcset='{{ img | image_url: width: 420 }} 420w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w' sizes='(max-width: 749px) 230px, 300px' width='{{ img.width }}' height='{{ img.height }}' alt='' loading='lazy' draggable='false'>
                {%- endif -%}
              </span></span>
              {%- if tag != blank -%}<span class='hzr-tag'>{{ tag | escape }}</span>{%- endif -%}
            </button>
          </div>
          {%- capture j -%}{%- if n > 0 -%},{%- endif -%}{"t":{{ p.title | json }},"p":{{ p.price | money_without_trailing_zeros | strip_html | json }},"c":{% if p.compare_at_price > p.price %}{{ p.compare_at_price | money_without_trailing_zeros | strip_html | json }}{% else %}null{% endif %},"u":{{ p.url | json }},"m":{% if p.featured_image != blank %}{{ p.featured_image | image_url: width: 1100 | json }}{% else %}null{% endif %},"v":[{%- for v in p.variants -%}{"id":{{ v.id }},"t":{{ v.title | json }},"a":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}{%- endcapture -%}
          {%- assign json = json | append: j -%}
          {%- assign n = n | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <p class='hzr-name' aria-live='polite' data-hint='{{ s.hint | escape }}' data-hint-m='{{ s.hint_mobile | escape }}'><span class='n'></span><span class='p'></span></p>
  {%- if s.button_label != blank -%}
    <a class='hzr-cta' href='{{ s.button_link | default: routes.all_products_collection_url }}'>{{ s.button_label }}</a>
  {%- endif -%}
  <script type='application/json' class='hzr-data'>[{{ json }}]</script>
  <div class='hzr-ov' hidden role='dialog' aria-modal='true' aria-label='{{ s.heading | default: 'Komad' | escape }}'>
    <div class='bk'></div>
    <button type='button' class='hzr-x' aria-label='Zatvori'>&times;</button>
    <div class='hzr-m'>
      <figure class='hzr-m-fig'><img class='mod' alt=''><img class='cut' alt=''></figure>
      <div class='hzr-m-info'>
        <p class='hzr-m-eb'>{{ s.modal_eyebrow | escape }}</p>
        <h3 class='hzr-m-t'></h3>
        <p class='hzr-m-p'></p>
        <p class='hzr-m-l'>Veličina</p>
        <div class='hzr-sz' role='group' aria-label='Veličina'></div>
        <button type='button' class='hzr-add' data-add='Dodaj u korpu' data-added='Dodato u korpu ✓' data-sold='Rasprodato' data-pick='Izaberi veličinu' data-go='Idi u korpu' data-err='Nije uspelo, pokušaj ponovo.'>Dodaj u korpu</button>
        <p class='hzr-msg' aria-live='polite'></p>
        <div class='hzr-links'><a class='hzr-m-link' href='#'>Pogledaj sve detalje</a><button type='button' class='hzr-toggle' data-on='Vidi na modelu' data-off='Vidi na vešalici'>Vidi na modelu</button></div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('hzr-{{ section.id }}');
  if (!root || root.dataset.ready) return; root.dataset.ready = '1';
  var data = []; try { data = JSON.parse(root.querySelector('.hzr-data').textContent); } catch (e) {}
  var sc = root.querySelector('.hzr-scroller'), track = root.querySelector('.hzr-track');
  var items = Array.prototype.slice.call(root.querySelectorAll('.hzr-item'));
  var nameEl = root.querySelector('.hzr-name'), ov = root.querySelector('.hzr-ov');
  if (ov && ov.parentNode !== document.body) document.body.appendChild(ov); // da ga ništa iznad ne iseče
  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
  var isMobile = function () { return window.matchMedia('(max-width: 749px)').matches; };

  /* kuka svake vešalice tačno na šipku: meri se gde počinje komad na slici */
  items.forEach(function (li) {
    var shown = li.querySelector('img'), img = new Image(); img.crossOrigin = 'anonymous';
    var measure = function () {
      try {
        var w = 172, h = Math.round(w * img.naturalHeight / img.naturalWidth), c = document.createElement('canvas');
        c.width = w; c.height = h; var x = c.getContext('2d', { willReadFrequently: true }); x.drawImage(img, 0, 0, w, h);
        var d = x.getImageData(0, 0, w, h).data;
        for (var y = 0; y < h; y++) for (var k = 0; k < w; k++) if (d[(y * w + k) * 4 + 3] > 24) { li.style.setProperty('--hk', (y / h).toFixed(4)); return; }
      } catch (e) {}
    };
    img.addEventListener('load', measure, { once: true }); img.src = shown.currentSrc || shown.src;
  });

  /* ulazak: komadi kliznu po šipci kad sekcija uđe u ekran */
  var go = function () { root.classList.add('is-in'); };
  if (reduce || !('IntersectionObserver' in window)) go();
  else { var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { go(); io.disconnect(); } }); }, { threshold: 0.25 }); io.observe(root); }

  /* ime i cena ispod šipke */
  var showName = function (i) { var d = data[i]; if (!d || !nameEl) return; nameEl.classList.remove('hint'); nameEl.querySelector('.n').textContent = d.t; nameEl.querySelector('.p').textContent = d.p; nameEl.classList.add('on'); };
  var showHint = function () { if (!nameEl) return; nameEl.classList.add('on', 'hint'); nameEl.querySelector('.n').textContent = ''; nameEl.querySelector('.p').textContent = isMobile() ? nameEl.dataset.hintM : nameEl.dataset.hint; };
  showHint();
  items.forEach(function (li, i) {
    li.addEventListener('mouseenter', function () { if (!isMobile()) showName(i); });
    li.querySelector('.hzr-hang').addEventListener('focus', function () { showName(i); });
  });
  track.addEventListener('mouseleave', function () { if (!isMobile()) showHint(); });

  /* telefon: komad na sredini je istaknut */
  var cur = -1, raf = 0;
  var center = function () {
    raf = 0; var mid = sc.getBoundingClientRect().left + sc.clientWidth / 2, best = -1, bd = 1e9;
    items.forEach(function (li, i) { var r = li.getBoundingClientRect(), d = Math.abs(r.left + r.width / 2 - mid); if (d < bd) { bd = d; best = i; } });
