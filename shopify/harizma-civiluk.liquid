    { "type": "url", "id": "button_link", "label": "Link dugmeta" },
    { "type": "checkbox", "id": "stock_tags", "label": "Oznaka kad ostane poslednji komad", "default": true },
    { "type": "text", "id": "tag_last", "label": "Tekst oznake za poslednji komad", "default": "Poslednji komad" },
